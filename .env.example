# ── Frontend (Vite) ─────────────────────────────────────────
# Copy to .env.local for local development.
# URL of the Bharosa FastAPI backend. Dev default: http://localhost:8000.
# Production builds default to the same origin (/api on Vercel), so leave it unset there.
VITE_API_URL=http://localhost:8000

# ── Backend (FastAPI) — set on the backend process / in Vercel project settings, never as VITE_ ──
# HS256 signing key for login tokens. Required in production (generate: python -c "import secrets;print(secrets.token_urlsafe(48))").
# BHAROSA_SECRET=
# PostgreSQL connection string for accounts. Unset = local SQLite file (backend/bharosa.db).
# On Supabase use the transaction pooler URL (port 6543).
# BHAROSA_DATABASE_URL=postgresql://user:password@host:6543/postgres
# Comma-separated account IDs (from the users table) allowed to open /admin. Empty = nobody.
# BHAROSA_ADMIN_USER_IDS=
# Allowed browser origins when the frontend is on a different origin from the API.
# BHAROSA_CORS_ORIGINS=http://localhost:5173
# Folder with the pipeline's JSON exports. Default: ml/exports
# BHAROSA_EXPORTS=
